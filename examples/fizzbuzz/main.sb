fn fizz() {
    print_char('F');
    print_char('i');
    print_char('z');
    println_char('z');
}

fn buzz() {
    print_char('B');
    print_char('u');
    print_char('z');
    println_char('z');
}

fn fizzbuzz() {
    print_char('F');
    print_char('i');
    print_char('z');
    print_char('z');
    print_char('B');
    print_char('u');
    print_char('z');
    println_char('z');
}

fn main() {
    for (var num = 3; num <= 50; num += 1) {
        if (num % 15 == 0) {
            fizzbuzz();
        } else if (num % 5 == 0) {
            fizz();
        } else if (num % 3 == 0) {
            buzz();
        } else {
            println_i32(num);
        }
    }
}
