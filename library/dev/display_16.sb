fn init_display_16() {
    asm {
        addi T0 = R0, 2
        out R0[6] = T0
    }
}

fn set_pallet(id: i32, r: i32, g: i32, b: i32) {
    var value = (id << 24) | (r << 16) | (g << 8) | b;
    asm {
        out R0[7] = value
    }
}

fn draw_pixel(x: i32, y: i32, color: i32) {
    var x = x >> 1;
    var color = ((color & 0x0F) << 4) | (color & 0x0F);
    var addr1 = 0x10000000 + x + (y << 6);
    var addr2 = 0x10000000 + x + ((y + 1) << 6);
    asm {
        add R7 = R0, addr1
        out R7[0] = color
        add R7 = R0, addr2
        out R7[0] = color
    }
}

fn draw_hline(x0: i32, x1: i32, y: i32, color: i32) {
    for (var x = x0; x <= x1; x += 1) {
        draw_pixel(x, y, color);
    }
}

fn draw_vline(x: i32, y0: i32, y1: i32, color: i32) {
    for (var y = y0; y <= y1; y += 1) {
        draw_pixel(x, y, color);
    }
}

fn draw_rect(x: i32, y: i32, w: i32, h: i32, color: i32) {
    for (var j = 0; j < h; j += 1) {
        for (var i = 0; i < w; i += 1) {
            draw_pixel(x + i, y + j, color);
        }
    }
}

fn draw_rect_line(x: i32, y: i32, w: i32, h: i32, color: i32) {
    for (var i = 0; i < w; i += 1) {
        draw_pixel(x + i, y, color);
        draw_pixel(x + i, y + h - 1, color);
    }
    for (var j = 0; j < h; j += 1) {
        draw_pixel(x, y + j, color);
        draw_pixel(x + w - 1, y + j, color);
    }
}

fn draw_circle(cx: i32, cy: i32, r: i32, color: i32) {
    var x = 0;
    var y = r;
    var d = 1 - r;

    while (x <= y) {
        draw_hline(cx - x, cx + x, cy + y, color);
        draw_hline(cx - x, cx + x, cy - y, color);
        draw_hline(cx - y, cx + y, cy + x, color);
        draw_hline(cx - y, cx + y, cy - x, color);

        if (d < 0) {
            d += 2 * x + 3;
        } else {
            d += 2 * (x - y) + 5;
            y -= 1;
        }

        x += 1;
    }
}

fn draw_circle_line(cx: i32, cy: i32, r: i32, color: i32) {
    var x = 0;
    var y = r;
    var d = 1 - r;

    while (x <= y) {
        draw_pixel(cx + x, cy + y, color);
        draw_pixel(cx - x, cy + y, color);
        draw_pixel(cx + x, cy - y, color);
        draw_pixel(cx - x, cy - y, color);
        draw_pixel(cx + y, cy + x, color);
        draw_pixel(cx - y, cy + x, color);
        draw_pixel(cx + y, cy - x, color);
        draw_pixel(cx - y, cy - x, color);

        if (d < 0) {
            d += 2 * x + 3;
        } else {
            d += 2 * (x - y) + 5;
            y -= 1;
        }

        x += 1;
    }
}
