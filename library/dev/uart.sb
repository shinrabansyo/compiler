fn print_char(c: char) {
    var c = c as i32;
    asm { out R0[0] = c }
}

fn println_char(c: char) {
    print_char(c);

    var ln = '\n' as i32;
    asm { out R0[0] = ln }
}

fn print_i32(value: i32)  {
    // 上位桁
    if (value >= 10) {
        print_i32(value / 10);
    }

    // 下位桁
    var digit = value % 10;
    var digit = digit + ('0' as i32);
    asm { out R0[0] = digit }
}

fn println_i32(value: i32) {
    print_i32(value);

    var ln = '\n' as i32;
    asm { out R0[0] = ln }
}
