// インラインアセンブリ記述のテスト

fn main() {
    // r10 レジスタを 0 以外の値にする
    asm! {
        addi R4 = R0, 9999
        add R10 = R0, R4
    }

    // テスト実行
    if (test_01() != 1) { return 1; }
    if (test_02() != 1) { return 2; }
    if (test_03() != 1) { return 3; }
    if (test_04() != 1) { return 4; }
    if (test_05() != 1) { return 5; }
    if (test_06() != 1) { return 6; }

    // 正常時は 0
    return 0;
}

fn test_01() {
    var result: i32 = 0;
    asm! {
        addi R4 = R0, 1
        add result = R0, R4
    }
    return result;
}

fn test_02() {
    var result: i32 = 0;
    asm! {
        addi R4 = R0, 10
        addi R5 = R0, 10
        addi R6 = R0, 1
        beq R0, (R4, R5) -> 12
        beq R0, (R0, R0) -> 18
        add result = R0, R6
        beq R0, (R0, R0) -> 12
        add result = R0, R0
    }
    return result;
}

fn test_03() {
    var result: i32 = 0;
    asm! {
        addi R4 = R0, 10
        addi R5 = R0, 10

        add tmp_a = R0, R4
        add tmp_b = R0, R5

        addi R6 = R0, 1
        beq R0, (tmp_a, tmp_b) -> 12
        beq R0, (R0, R0) -> 18
        add result = R0, R6
        beq R0, (R0, R0) -> 12
        add result = R0, R0
    }
    return result;
}

fn test_04() {
    var result: i32 = 0;
    asm! {
        addi R4 = R0, 1
        sw R0[0] = R4
        lw result = R0[0]
    }
    return result;
}

fn test_05() {
    var result: i32 = 1;
    asm! {
        in result = R0[0]
    }
    return result == 0;
}

fn test_06() {
    asm! {
        addi R4 = R0, 98
        out R0[0] = R4
    }
    return 1;
}
