// インラインアセンブリ記述のテスト

fn main() {
    if (test_01() != 1) { return 1; }
    if (test_02() != 1) { return 2; }
    if (test_03() != 1) { return 3; }
    if (test_04() != 1) { return 4; }
    return 0;
}

fn test_01() {
    var result: i32 = 0;
    asm! {
        addi R4 = R0, 1
        add result = R0, R4
    }
    return result;
}

fn test_02() {
    var result: i32 = 0;
    asm! {
        addi R4 = R0, 10
        addi R5 = R0, 10
        addi R6 = R0, 1
        beq R0, (R4, R5) -> 12
        beq R0, (R0, R0) -> 18
        add result = R0, R6
        beq R0, (R0, R0) -> 12
        add result = R0, R0
    }
    return result;
}

fn test_03() {
    var result: i32 = 0;
    asm! {
        addi R4 = R0, 10
        addi R5 = R0, 10

        add T0 = R0, R4
        add T1 = R0, R5

        addi R6 = R0, 1
        beq R0, (T0, T1) -> 12
        beq R0, (R0, R0) -> 18
        add result = R0, R6
        beq R0, (R0, R0) -> 12
        add result = R0, R0
    }
    return result;
}

fn test_04() {
    var result: i32 = 0;
    asm! {
        addi R4 = R0, 1
        sw R0[0] = R4
        lw result = R0[0]
    }
    return result;
}
