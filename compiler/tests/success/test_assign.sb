// 代入のテスト

fn main() -> i32 {
    // r10 レジスタを 0 以外の値にする
    asm {
        addi R4 = R0, 9999
        add R10 = R0, R4
    }

    // テスト実行
    if (!test_01()) { return 1; }
    if (!test_02()) { return 2; }
    if (!test_03()) { return 3; }
    if (!test_04()) { return 4; }
    if (!test_05()) { return 5; }
    if (!test_06()) { return 6; }
    if (!test_07()) { return 7; }
    if (!test_08()) { return 8; }

    // 正常時は 0
    return 0;
}

fn test_01() -> bool {
    var value = 10;
    value = 20;
    return value == 20;
}

fn test_02() -> bool {
    var value = 10;
    value += 20;
    return value == 30;
}

fn test_03() -> bool {
    var value = 10;
    value -= 20;
    return value == (0-10);
}

fn test_04() -> bool {
    var value = 10;
    value *= 2;
    return value == 20;
}

fn test_05() -> bool {
    var value = 20;
    value /= 2;
    return value == 10;
}

fn test_06() -> bool {
    var value = 12;
    value %= 5;
    return value == 2;
}

fn test_07() -> bool {
    var value = 1;
    value <<= 4;
    return value == 16;
}

fn test_08() -> bool {
    var value = 16;
    value >>= 4;
    return value == 1;
}
