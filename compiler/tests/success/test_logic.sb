// 論理式のテスト

fn main() -> i32 {
    // r10 レジスタを 0 以外の値にする
    asm! {
        addi R4 = R0, 9999
        add R10 = R0, R4
    }

    // テスト実行
    if (test_01() != true) { return 1; }
    if (test_02() != true) { return 2; }
    if (test_03() != true) { return 3; }
    if (test_04() != true) { return 4; }
    if (test_05() != true) { return 5; }
    if (test_06() != true) { return 6; }
    if (test_07() != true) { return 7; }
    if (test_08() != true) { return 8; }

    // 正常時は 0
    return 0;
}

fn test_01() -> bool {
    return 10 == 10;
}

fn test_02() -> bool {
    return 10 >= 10;
}

fn test_03() -> bool {
    if (10 >= 11) {
        return false;
    } else {
        return true;
    }
    return true;  // TODO
}

fn test_04() -> bool {
    return (10 > 5) as bool;
}

fn test_05() -> bool {
    if (10 > 10) {
        return false;
    } else {
        return true;
    }
    return true;  // TODO
}

fn test_06() -> bool {
    return 1 || 0;
}

fn test_07() -> bool {
    return 1 && 1;
}

fn test_08() -> bool {
    return ((1 || 0) && (0 || 1)) && 1;
}
