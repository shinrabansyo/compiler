// 変数，式のテスト

fn main() -> i32 {
    // r10 レジスタを 0 以外の値にする
    asm! {
        addi R4 = R0, 9999
        add R10 = R0, R4
    }

    // テスト実行
    if (!test_01()) { return 1; }
    if (!test_02()) { return 2; }
    if (!test_03()) { return 3; }
    if (!test_04()) { return 4; }
    if (!test_05()) { return 5; }
    if (!test_06()) { return 6; }
    if (!test_07()) { return 7; }
    if (!test_08()) { return 8; }
    if (!test_09()) { return 9; }
    if (!test_10()) { return 10; }
    if (!test_11()) { return 11; }
    if (!test_12()) { return 12; }
    if (!test_13()) { return 13; }
    if (!test_14()) { return 14; }
    if (!test_15()) { return 15; }
    if (!test_16()) { return 16; }
    if (!test_17()) { return 17; }
    if (!test_18()) { return 18; }
    if (!test_19()) { return 19; }
    if (!test_20()) { return 20; }
    if (!test_21()) { return 21; }
    if (!test_22()) { return 22; }

    // 正常時は 0
    return 0;
}

fn test_01() -> bool {
    var value = 10;
    return value == 10;
}

fn test_02() -> bool {
    var value = (10 + 20) - 30;
    return value == 0;
}

fn test_03() -> bool {
    var value_1 = 10;
    var value_2 = 20;
    var value_3 = 30;
    var sum = value_1 + value_2 + value_3;
    return sum == 60;
}

fn test_04() -> bool {
    var value_1 = 10;
    var value_2 = 20;
    var sum_1 = value_1 + value_2;
    var sum_2 = 10 + sum_1;
    return sum_2 == 40;
}

fn test_05() -> bool {
    var value_1 = 0;
    var value_2 = 10;
    var diff = value_1 - value_2;
    return diff == -10;
}

fn test_06() -> bool {
    var value_1 = 0;
    var value_2 = 10;
    var sum = value_1 + value_2;
    return sum == +10;
}

fn test_07() -> bool {
    return (1 << 4) == 16;
}

fn test_08() -> bool {
    var a = 5;
    var b = 2;
    return (a | b) == 7;
}

fn test_09() -> bool {
    var a = 5;
    var b = 2;
    return (a ^ b) == 7;
}

fn test_10() -> bool {
    var a = 5;
    var b = 2;
    return (a & b) == 0;
}

fn test_11() -> bool {
    var a = 12;
    var b = 4;
    return (a * b) == 48;
}

fn test_12() -> bool {
    var a = 12;
    var b = 0;
    return (a * b) == 0;
}

fn test_13() -> bool {
    var a = 12;
    var b = 4;
    return (a / b) == 3;
}

fn test_14() -> bool {
    var a = 12;
    var b = -4;
    return (a / b) == -3;
}

fn test_15() -> bool {
    var a = -12;
    var b = 4;
    return (a / b) == -3;
}

fn test_16() -> bool {
    var a = -12;
    var b = -4;
    return (a / b) == 3;
}

fn test_17() -> bool {
    var a = 12;
    var b = 0;
    return (a / b) == -1;
}

fn test_18() -> bool {
    var a = 13;
    var b = 5;
    return (a % b) == 3;
}

fn test_19() -> bool {
    var a = 13;
    var b = -5;
    return (a % b) == 3;
}

fn test_20() -> bool {
    var a = -13;
    var b = 5;
    return (a % b) == -3;
}

fn test_21() -> bool {
    var a = -13;
    var b = -5;
    return (a % b) == -3;
}

fn test_22() -> bool {
    var a = 13;
    var b = 0;
    return (a % b) == a;
}
