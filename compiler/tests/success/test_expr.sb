// 変数，式のテスト

fn main() -> i32 {
    // r10 レジスタを 0 以外の値にする
    asm! {
        addi R4 = R0, 9999
        add R10 = R0, R4
    }

    // テスト実行
    if (test_01() != true) { return 1; }
    if (test_02() != true) { return 2; }
    if (test_03() != true) { return 3; }
    if (test_04() != true) { return 4; }
    if (test_05() != true) { return 5; }
    if (test_06() != true) { return 6; }
    if (test_07() != true) { return 7; }
    if (test_08() != true) { return 8; }
    if (test_09() != true) { return 9; }
    if (test_10() != true) { return 10; }

    // 正常時は 0
    return 0;
}

fn test_01() -> bool {
    var value = 10;
    return value == 10;
}

fn test_02() -> bool {
    var value = (10 + 20) - 30;
    return value == 0;
}

fn test_03() -> bool {
    var value_1 = 10;
    var value_2 = 20;
    var value_3 = 30;
    var sum = value_1 + value_2 + value_3;
    return sum == 60;
}

fn test_04() -> bool {
    var value_1 = 10;
    var value_2 = 20;
    var sum_1 = value_1 + value_2;
    var sum_2 = 10 + sum_1;
    return sum_2 == 40;
}

fn test_05() -> bool {
    var value_1 = 0;
    var value_2 = 10;
    var diff = value_1 - value_2;
    return diff == -10;
}

fn test_06() -> bool {
    var value_1 = 0;
    var value_2 = 10;
    var sum = value_1 + value_2;
    return sum == +10;
}

fn test_07() -> bool {
    return (1 << 4) == 16;
}

fn test_08() -> bool {
    var a = 5;
    var b = 2;
    return (a | b) == 7;
}

fn test_09() -> bool {
    var a = 5;
    var b = 2;
    return (a ^ b) == 7;
}

fn test_10() -> bool {
    var a = 5;
    var b = 2;
    return (a & b) == 0;
}
