// for 文のテスト

fn main() -> i32 {
    // r10 レジスタを 0 以外の値にする
    asm! {
        addi R4 = R0, 9999
        add R10 = R0, R4
    }

    // テスト実行
    if (!test_01()) { return 1; }
    if (!test_02()) { return 2; }

    // 正常時は 0
    return 0;
}

fn test_01() -> bool {
    var sum = 0;
    for (var idx = 0; idx < 10; idx += 1) {
        sum += 1;
    }
    return sum == 10;
}

fn test_02() -> bool {
    var sum = 0;
    for (var idx = 1; idx <= 10; idx += 1) {
        sum += idx;
    }
    return sum == 55;
}
