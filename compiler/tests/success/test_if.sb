// if 文のテスト

fn main() -> i32 {
    // r10 レジスタを 0 以外の値にする
    asm {
        addi R4 = R0, 9999
        add R10 = R0, R4
    }

    // テスト実行
    if (!test_01()) { return 1; }
    if (!test_02()) { return 2; }
    if (!test_03()) { return 3; }

    // 正常時は 0
    return 0;
}

fn test_01() -> bool {
    if (0 == 0) {
        return true;
    } else {
        return false;
    }
    return true;  // TODO
}

fn test_02() -> bool {
    if (10 + 20 == (10 - 20) + 40) {
        return true;
    } else {
        return false;
    }
    return true;  // TODO
}

fn test_03() -> bool {
    if (0 == 1) {
        return false;
    } else if(0 == 2) {
        return false;
    } else {
        return true;
    }
    return true;  // TODO
}
