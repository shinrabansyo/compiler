// while 文のテスト

fn main() {
    // r10 レジスタを 0 以外の値にする
    asm! {
        addi R4 = R0, 9999
        add R10 = R0, R4
    }

    // テスト実行
    if (test_01() != 1) { return 1; }
    if (test_02() != 1) { return 2; }

    // 正常時は 0
    return 0;
}

fn test_01() {
    var idx: i32 = 10;
    var cnt: i32 = 0;
    while (idx > 0) {
        idx -= 1;
        cnt += 1;
    }
    return cnt == 10;
}

fn test_02() {
    var sum: i32 = 0;
    var cnt: i32 = 0;
    while (sum < 50) {
        cnt += 1;
        sum += cnt;
    }
    return sum == 55;
}
