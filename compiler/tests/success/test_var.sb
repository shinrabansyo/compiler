// 変数のテスト

fn main() -> i32 {
    // r10 レジスタを 0 以外の値にする
    asm! {
        addi R4 = R0, 9999
        add R10 = R0, R4
    }

    // テスト実行
    if (!test_01()) { return 1; }
    if (!test_02()) { return 2; }
    if (!test_03()) { return 3; }

    // 正常時は 0
    return 0;
}

fn test_01() -> bool {
    var a = 10;
    return a == 10;
}

fn test_02() -> bool {
    var a = 10;
    var b = 10;
    return a == b;
}

fn test_03() -> bool {
    var a = 1;
    var b = 2;
    var c = 3;
    var d = 4;
    var e = 5;
    var f = 6;
    var g = 7;
    var h = 8;
    var i = 9;
    var j = 10;
    var k = 11;
    var l = 12;
    var m = 13;
    var n = 14;
    var o = 15;
    var p = 16;
    var q = 17;
    var r = 18;
    var s = 19;
    var t = 20;
    var sum = a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p + q + r + s + t;
    return sum == 210;
}
