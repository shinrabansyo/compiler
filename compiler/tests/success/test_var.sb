// 変数のテスト

fn main() {
    // r10 レジスタを 0 以外の値にする
    asm! {
        addi R4 = R0, 9999
        add R10 = R0, R4
    }

    // テスト実行
    if (test_01() != 1) { return 1; }
    if (test_02() != 1) { return 2; }
    if (test_03() != 1) { return 3; }

    // 正常時は 0
    return 0;
}

fn test_01() {
    var a: i32 = 10;
    return a == 10;
}

fn test_02() {
    var a: i32 = 10;
    var b: i32 = 10;
    return a == b;
}

fn test_03() {
    var a: i32 = 1;
    var b: i32 = 2;
    var c: i32 = 3;
    var d: i32 = 4;
    var e: i32 = 5;
    var f: i32 = 6;
    var g: i32 = 7;
    var h: i32 = 8;
    var i: i32 = 9;
    var j: i32 = 10;
    var k: i32 = 11;
    var l: i32 = 12;
    var m: i32 = 13;
    var n: i32 = 14;
    var o: i32 = 15;
    var p: i32 = 16;
    var q: i32 = 17;
    var r: i32 = 18;
    var s: i32 = 19;
    var t: i32 = 20;
    var sum: i32 = a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p + q + r + s + t;
    return sum == 210;
}
